{
  "manifest_version": 3,
  "name": "Web Element Locator",
  "version": "0.2.0",
  "description": "Open-source MIT extension for copying a clear locator for a clicked page element.",
  "homepage_url": "https://github.com/panth-net/web-element-locator-chrome-extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Web Element Locator",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "start-identifying": {
      "description": "Identify a page element"
    }
  }
}
